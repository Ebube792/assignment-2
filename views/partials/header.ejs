<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Ebube Okoronkwo</title>
  <!-- Bootstrap CSS (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome (CDN) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <!-- Our own CSS from the public folder (no "public" in the path) -->
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/"><i class="fa-solid fa-code"></i> Ebube Okoronkwo</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav ms-auto">
          <!-- Highlights the current page by comparing the title local -->
          <li class="nav-item"><a class="nav-link <%= title === 'Home' ? 'active' : '' %>" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link <%= title === 'About Me' ? 'active' : '' %>" href="/about">About</a></li>
          <li class="nav-item"><a class="nav-link <%= title === 'Projects' ? 'active' : '' %>" href="/projects">Projects</a></li>
          <li class="nav-item"><a class="nav-link <%= title === 'Contact Me' ? 'active' : '' %>" href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>
  </nav>
  <main class="container my-5 flex-grow-1">
